# GitHub API Integration (Fine-Grained Personal Access Token or Classic PAT)
# Fine-grained PAT permissions needed:
# - Repository access: Only select repositories (AnugrujaArtsStudio, AnugrujaArtsStudio-Admin)
# - Permissions: Contents: Read and write, Metadata: Read-only
GITHUB_TOKEN=
GITHUB_OWNER=abhay2008
GITHUB_REPO=AnugrujaArtsStudio
GITHUB_ADMIN_REPO=AnugrujaArtsStudio-Admin
GITHUB_BRANCH=main

# Studio Portal Security — REQUIRED, no defaults. Generate strong values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Keep real values ONLY in .env.local (gitignored) and Vercel environment variables.
ADMIN_PASSWORD=
SESSION_SECRET=

# Public site address used by the portal's "View Website" links.
# Optional: a production build defaults to the live site, local dev to
# http://localhost:3000. Set it to preview a different deployment.
NEXT_PUBLIC_SITE_URL=

# Local Dev Persistence (Optional: syncs directly to sibling public repo files when running locally)
DEVELOPMENT_LOCAL_SAVE=true
