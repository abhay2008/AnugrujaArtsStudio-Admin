# GitHub API Integration (Fine-Grained Personal Access Token or Classic PAT)
# Fine-grained PAT permissions needed:
# - Repository access: Only select repositories (AnugrujaArtsStudio, AnugrujaArtsStudio-Admin)
# - Permissions: Contents: Read and write, Metadata: Read-only
GITHUB_TOKEN=
GITHUB_OWNER=abhay2008
GITHUB_REPO=AnugrujaArtsStudio
GITHUB_ADMIN_REPO=AnugrujaArtsStudio-Admin
GITHUB_BRANCH=main

# Studio Portal Security
ADMIN_PASSWORD=REDACTED-SECRET-REMOVED-FROM-HISTORY
SESSION_SECRET=anugruja_arts_studio_secret_session_key_2026

# Local Dev Persistence (Optional: syncs directly to sibling public repo files when running locally)
DEVELOPMENT_LOCAL_SAVE=true
